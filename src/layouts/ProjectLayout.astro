---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  summary: string;
  formattedDate: string;
  stack: string[];
  headings: Heading[];
  githubUrl?: string;
  demoUrl?: string;
  canonicalPath: string;
  role?: string;
  impact?: string;
  duration?: string;
  metrics?: Array<{ label: string; value: string }>;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  summary,
  formattedDate,
  stack,
  headings,
  githubUrl,
  demoUrl,
  canonicalPath,
  role,
  impact,
  duration,
  metrics = [],
  jsonLd,
} = Astro.props;
---

<BaseLayout title={`${title} | System Documentation`} description={summary} canonicalPath={canonicalPath} ogType="article" jsonLd={jsonLd}>
  <nav class="border-b border-slate-800 bg-tech-surface/50 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-sm font-mono text-slate-400 hover:text-tech-accent transition-colors">
        ← Back to Home
      </a>
      <span class="text-xs font-mono text-slate-500">{formattedDate}</span>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-6 py-12 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-12">
    <article class="lg:col-span-8">
        <header class="mb-12 border-b border-slate-800 pb-10">
            <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
            {title}
            </h1>

            <p class="text-lg text-slate-400 leading-relaxed mb-8">
            {summary}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
                {impact && <div class="rounded-lg border border-slate-700 p-3"><p class="text-xs text-slate-500">Impact</p><p class="text-sm text-slate-200">{impact}</p></div>}
                {role && <div class="rounded-lg border border-slate-700 p-3"><p class="text-xs text-slate-500">Role</p><p class="text-sm text-slate-200">{role}</p></div>}
                {duration && <div class="rounded-lg border border-slate-700 p-3"><p class="text-xs text-slate-500">Duration</p><p class="text-sm text-slate-200">{duration}</p></div>}
            </div>

            {metrics.length > 0 && (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
                    {metrics.map((m) => (
                        <div class="rounded-lg border border-slate-700 p-3">
                            <p class="text-xs text-slate-500">{m.label}</p>
                            <p class="text-base font-semibold text-white">{m.value}</p>
                        </div>
                    ))}
                </div>
            )}

            <div class="flex flex-wrap gap-4">
            {githubUrl && (
                <a
                href={githubUrl}
                target="_blank"
                rel="noreferrer"
                class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition-colors border border-slate-700"
                >
                View Source Code
                </a>
            )}

            {demoUrl && (
                <a
                href={demoUrl}
                target="_blank"
                rel="noreferrer"
                class="px-4 py-2 bg-tech-accent/10 hover:bg-tech-accent/20 text-tech-accent rounded-lg text-sm font-medium transition-colors border border-tech-accent/50"
                >
                Live Deployment
                </a>
            )}
            </div>
        </header>

        <div
            class="prose prose-invert prose-slate max-w-none
                prose-headings:text-white prose-headings:font-bold
                prose-a:text-tech-accent hover:prose-a:text-white transition-colors
                prose-code:text-tech-accent prose-code:bg-slate-800 prose-code:px-1 prose-code:rounded
                prose-pre:bg-[#0d1117] prose-pre:border prose-pre:border-slate-800"
        >
            <slot />
        </div>
    </article>

    <aside class="lg:col-span-4 hidden lg:block">
      <div class="sticky top-24 border border-slate-800 bg-tech-surface p-6 rounded-2xl">
        <h3 class="text-sm font-mono text-white uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          System Architecture
        </h3>

        <div class="flex flex-wrap gap-2 mb-8">
          {stack.map((tech) => (
            <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-slate-800/50 text-slate-300 border border-slate-700">
              {tech}
            </span>
          ))}
        </div>

        <h3 class="text-sm font-mono text-white uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Contents
        </h3>

        <TableOfContents headings={headings} />
      </div>
    </aside>
  </main>
</BaseLayout>
---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  summary: string;
  formattedDate: string;
  stack: string[];
  headings: Heading[];
  githubUrl?: string;
  demoUrl?: string;
  canonicalPath: string;
  role?: string;
  impact?: string;
  duration?: string;
  metrics?: Array<{ label: string; value: string }>;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  summary,
  formattedDate,
  stack,
  headings,
  githubUrl,
  demoUrl,
  canonicalPath,
  role,
  impact,
  duration,
  metrics = [],
  jsonLd,
} = Astro.props;
---

<BaseLayout title={`${title} | System Documentation`} description={summary} canonicalPath={canonicalPath} ogType="article" jsonLd={jsonLd}>
  <nav class="border-b border-slate-800 bg-tech-surface/50 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="text-sm font-mono text-slate-400 hover:text-tech-accent transition-colors">
        ← Back to Systems
      </a>
      <span class="text-xs font-mono text-slate-500">{formattedDate}</span>
    </div>
  </nav>

  <main class="max-w-5xl mx-auto px-6 py-12 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <article class="lg:col-span-8">
        
        <header class="mb-16">
            <h1 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight tracking-tight">
              {title}
            </h1>
            <p class="text-xl text-slate-400 leading-relaxed mb-10">
              {summary}
            </p>

            {(role || impact || duration || metrics.length > 0) && (
              <div class="bg-slate-800/20 border border-slate-700/50 rounded-xl p-6 mb-10">
                  <h3 class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-4 border-b border-slate-700/50 pb-2">Project Overview</h3>
                  
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-8 mb-6">
                      {role && <div><p class="text-xs text-slate-500 mb-1">Role</p><p class="text-sm font-medium text-slate-200">{role}</p></div>}
                      {duration && <div><p class="text-xs text-slate-500 mb-1">Duration</p><p class="text-sm font-medium text-slate-200">{duration}</p></div>}
                      {impact && <div class="sm:col-span-2"><p class="text-xs text-slate-500 mb-1">Core Impact</p><p class="text-sm font-medium text-tech-accent">{impact}</p></div>}
                  </div>

                  {metrics.length > 0 && (
                      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-slate-700/50 pt-4">
                          {metrics.map((m) => (
                              <div>
                                  <p class="text-xs text-slate-500 mb-1">{m.label}</p>
                                  <p class="text-lg font-bold text-white tracking-tight">{m.value}</p>
                              </div>
                          ))}
                      </div>
                  )}
              </div>
            )}

            <div class="flex flex-wrap gap-4">
              {githubUrl && (
                  <a href={githubUrl} target="_blank" rel="noreferrer" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white rounded-lg text-sm font-medium transition-colors border border-slate-700 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
                    Source Code
                  </a>
              )}
              {demoUrl && (
                  <a href={demoUrl} target="_blank" rel="noreferrer" class="px-5 py-2.5 bg-tech-accent/10 hover:bg-tech-accent/20 text-tech-accent rounded-lg text-sm font-medium transition-colors border border-tech-accent/50 flex items-center gap-2">
                    Live Deployment
                  </a>
              )}
            </div>
        </header>

        <div class="prose prose-invert prose-slate max-w-none
            prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight
            prose-h2:text-3xl prose-h2:mt-16 prose-h2:mb-6 prose-h2:border-b prose-h2:border-slate-800/60 prose-h2:pb-4
            prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4 prose-h3:text-slate-200
            prose-p:leading-relaxed prose-p:mb-6 prose-p:text-slate-300
            prose-li:text-slate-300 prose-li:my-1
            prose-strong:text-white prose-strong:font-semibold
            prose-a:text-tech-accent hover:prose-a:text-white transition-colors underline-offset-4
            prose-code:text-tech-accent prose-code:bg-slate-800/50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-[0.85em]
            prose-pre:bg-[#0B0F19] prose-pre:border prose-pre:border-slate-800 prose-pre:shadow-lg prose-pre:rounded-xl prose-pre:my-8
            prose-img:rounded-xl prose-img:border prose-img:border-slate-800"
        >
            <slot />
        </div>
    </article>

    <aside class="lg:col-span-4 hidden lg:block">
      <div class="sticky top-24 border border-slate-800 bg-tech-surface p-6 rounded-2xl shadow-xl">
        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          System Architecture
        </h3>

        <div class="flex flex-wrap gap-2 mb-8">
          {stack.map((tech) => (
            <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-slate-800/60 text-slate-300 border border-slate-700/50">
              {tech}
            </span>
          ))}
        </div>

        <h3 class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
          Contents
        </h3>

        <div class="max-h-[50vh] overflow-y-auto pr-2 custom-scrollbar">
            <TableOfContents headings={headings} />
        </div>
      </div>
    </aside>
  </main>
</BaseLayout>
---
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "Technical portfolio with case studies in data, ML, and software systems.",
  canonicalPath = "/",
  ogType = "website",
  ogImage = "/og-default.png",
  noIndex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : undefined;
const ogImageUrl = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <JsonLd data={jsonLd} />}

    <ClientRouter />
  </head>

  <body
    class="min-h-screen flex flex-col bg-tech-bg text-slate-300 font-sans antialiased selection:bg-tech-accent selection:text-tech-bg"
  >
    <header
      class="border-b border-slate-800 bg-tech-bg/80 backdrop-blur sticky top-0 z-50"
    >
      <div class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-4 flex items-center justify-between relative z-50">
        <a href="/" class="font-mono text-sm text-tech-accent font-bold tracking-tight">RivalMoh.dev</a>
        
        <nav class="hidden md:flex items-center gap-6 text-sm">
          {[
            { href: "/", label: "Home" },
            { href: "/about", label: "About" },
            { href: "/#projects", label: "Projects" },
            { href: "/contact", label: "Contact" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class={`hover:text-tech-accent transition-colors ${
                currentPath === href ? "text-tech-accent font-medium" : "text-slate-300"
              }`}
            >
              {label}
            </a>
          ))}
        </nav>

        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-[5px] p-2 z-50" aria-label="Toggle Menu">
          <span class="w-5 h-0.5 bg-slate-300 transition-transform origin-left"></span>
          <span class="w-5 h-0.5 bg-slate-300 transition-opacity"></span>
          <span class="w-5 h-0.5 bg-slate-300 transition-transform origin-left"></span>
        </button>
      </div>

      <nav id="mobile-menu" class="fixed inset-0 bg-tech-bg/98 backdrop-blur-2xl flex flex-col opacity-0 pointer-events-none transition-all duration-300 md:hidden z-40 pt-28 px-8 pb-12">
        <div class="flex flex-col gap-6">
          {[
            { href: "/", label: "Home" },
            { href: "/about", label: "About" },
            { href: "/#projects", label: "Projects" },
            { href: "/contact", label: "Contact" },
          ].map(({ href, label }) => (
            <a
              href={href}
              class={`text-4xl font-bold tracking-tight hover:text-tech-accent transition-colors mobile-link transform translate-y-4 opacity-0 transition-all duration-500 delay-100 ${
                currentPath === href ? "text-tech-accent" : "text-slate-300"
              }`}
            >
              {label}
            </a>
          ))}
        </div>

        <div class="mt-auto transform translate-y-4 opacity-0 transition-all duration-500 delay-300 fade-in-element">
          <p class="text-xs font-mono text-slate-500 uppercase tracking-wider mb-4 border-b border-slate-800 pb-2">
            Connect
          </p>
          <div class="flex items-center gap-6 text-base">
            <a href="https://github.com/RivalMoh" target="_blank" rel="noreferrer" class="text-slate-300 hover:text-tech-accent transition-colors">GitHub</a>
            <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noreferrer" class="text-slate-300 hover:text-tech-accent transition-colors">LinkedIn</a>
            <a href="/contact" class="text-slate-300 hover:text-tech-accent transition-colors">Email</a>
          </div>
        </div>
      </nav>
    </header>

    <div class="flex-grow">
      <slot />
    </div>

    <footer class="border-t border-slate-800 bg-tech-surface/30 mt-auto">
      <div class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm font-mono text-slate-500">© 2026 Rival Moh. Wahyudi</p>
        <div class="flex items-center gap-4 text-sm">
          <a href="https://github.com/RivalMoh" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-tech-accent transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noreferrer" class="text-slate-400 hover:text-tech-accent transition-colors">LinkedIn</a>
          <a href="/contact" class="text-slate-400 hover:text-tech-accent transition-colors">Email</a>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener('astro:page-load', () => {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        if (mobileBtn && mobileMenu) {
          let isOpen = false;
          
          const toggleMenu = () => {
            isOpen = !isOpen;
            // Get all inner elements we want to animate
            const animatedElements = document.querySelectorAll('.mobile-link, .fade-in-element');

            if (isOpen) {
              mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
              mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
              document.body.style.overflow = 'hidden';
              
              // Animate internal items
              animatedElements.forEach((el, index) => {
                setTimeout(() => {
                  el.classList.remove('translate-y-4', 'opacity-0');
                  el.classList.add('translate-y-0', 'opacity-100');
                }, 50 * index);
              });

              if (mobileBtn.children.length === 3) {
                mobileBtn.children[0].classList.add('rotate-45', 'translate-x-[2px]', '-translate-y-[1px]');
                mobileBtn.children[1].classList.add('opacity-0');
                mobileBtn.children[2].classList.add('-rotate-45', 'translate-x-[2px]', 'translate-y-[1px]');
              }
            } else {
              mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
              mobileMenu.classList.add('opacity-0', 'pointer-events-none');
              document.body.style.overflow = '';

              // Reset internal items
              animatedElements.forEach((el) => {
                el.classList.add('translate-y-4', 'opacity-0');
                el.classList.remove('translate-y-0', 'opacity-100');
              });

              if (mobileBtn.children.length === 3) {
                mobileBtn.children[0].classList.remove('rotate-45', 'translate-x-[2px]', '-translate-y-[1px]');
                mobileBtn.children[1].classList.remove('opacity-0');
                mobileBtn.children[2].classList.remove('-rotate-45', 'translate-x-[2px]', 'translate-y-[1px]');
              }
            }
          };

          // Remove any old listeners (if the script runs multiple times) by replacing the element
          // Alternatively, since astro:page-load rebuilds the DOM for the newly loaded page, 
          // adding listeners is perfectly safe here.
          mobileBtn.addEventListener('click', toggleMenu);
          mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
        }
      });
    </script>

    <Analytics />
  </body>
</html>

---
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
  ogImage?: string;
  noIndex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = "Technical portfolio with case studies in data, ML, and software systems.",
  canonicalPath = "/",
  ogType = "website",
  ogImage = "/og-default.png",
  noIndex = false,
  jsonLd,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : undefined;
const ogImageUrl = Astro.site
  ? new URL(ogImage, Astro.site).toString()
  : ogImage;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {jsonLd && <JsonLd data={jsonLd} />}

    <ClientRouter />
  </head>

  <body
    class="min-h-screen flex flex-col"
  >
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-bg-surface focus:text-text-primary focus:rounded focus:text-sm focus:font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
    >
      Skip to main content
    </a>

    <header
      class="border-b border-border-default bg-bg-base/80 backdrop-blur sticky top-0 z-50"
      role="banner"
    >
      <div class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-4 flex items-center justify-between relative z-50">
        <a href="/" class="font-display font-semibold text-text-primary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="RivalMoh.dev — home">RivalMoh.dev</a>
        
        <nav class="hidden md:flex items-center gap-6 text-sm" role="navigation" aria-label="Primary navigation">
          {[
            { href: "/", label: "Home" },
            { href: "/about", label: "About" },
            { href: "/#projects", label: "Projects" },
            { href: "/contact", label: "Contact" },
          ].map(({ href, label }) => (
            <a
              href={href}
              aria-current={currentPath === href || currentPath === href + '/' ? "page" : undefined}
              class={`nav-link hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded px-2 py-1 ${
                currentPath === href || currentPath === href + '/' ? "text-text-primary font-medium" : "text-text-secondary"
              }`}
            >
              {label}
            </a>
          ))}
        </nav>

        <button id="mobile-menu-btn" class="md:hidden flex flex-col gap-[5px] p-2 z-50 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="Toggle Menu">
          <span class="w-5 h-0.5 bg-text-primary transition-transform origin-left"></span>
          <span class="w-5 h-0.5 bg-text-primary transition-opacity"></span>
          <span class="w-5 h-0.5 bg-text-primary transition-transform origin-left"></span>
        </button>
      </div>

      <nav id="mobile-menu" class="fixed inset-0 bg-bg-base/98 backdrop-blur-2xl flex flex-col opacity-0 pointer-events-none transition-all duration-300 md:hidden z-40 pt-28 px-8 pb-12" role="navigation" aria-label="Mobile navigation">
        <div class="flex flex-col gap-6">
          {[
            { href: "/", label: "Home" },
            { href: "/about", label: "About" },
            { href: "/#projects", label: "Projects" },
            { href: "/contact", label: "Contact" },
          ].map(({ href, label }) => (
            <a
              href={href}
              aria-current={currentPath === href || currentPath === href + '/' ? "page" : undefined}
              class={`font-display text-4xl font-bold tracking-tight hover:text-accent transition-colors mobile-link transform translate-y-4 opacity-0 transition-all duration-500 delay-100 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded ${
                currentPath === href || currentPath === href + '/' ? "text-accent" : "text-text-primary"
              }`}
            >
              {label}
            </a>
          ))}
        </div>

        <div class="mt-auto transform translate-y-4 opacity-0 transition-all duration-500 delay-300 fade-in-element">
          <p class="text-xs font-mono text-text-secondary uppercase tracking-wider mb-4 border-b border-border-default pb-2" id="mobile-connect-label">
            Connect
          </p>
          <div class="flex items-center gap-6 text-base" aria-labelledby="mobile-connect-label">
            <a href="https://github.com/RivalMoh" target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="GitHub profile (opens in new tab)">GitHub</a>
            <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noopener noreferrer" class="text-text-primary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="LinkedIn profile (opens in new tab)">LinkedIn</a>
            <a href="/contact" class="text-text-primary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="Contact page">Email</a>
          </div>
        </div>
      </nav>
    </header>

    <main id="main-content" role="main" class="flex-grow flex flex-col">
      <slot />
    </main>

    <footer class="border-t border-border-default bg-bg-surface/30 mt-auto" role="contentinfo">
      <div class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm font-mono text-text-secondary">© 2026 Rival Moh. Wahyudi</p>
        <nav aria-label="Footer navigation">
          <div class="flex items-center gap-4 text-sm">
            <a href="https://github.com/RivalMoh" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="GitHub profile (opens in new tab)">GitHub</a>
            <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noopener noreferrer" class="text-text-secondary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="LinkedIn profile (opens in new tab)">LinkedIn</a>
            <a href="/contact" class="text-text-secondary hover:text-accent transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 rounded" aria-label="Contact page">Email</a>
          </div>
        </nav>
      </div>
    </footer>

    <script>
      document.addEventListener('astro:page-load', () => {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        if (mobileBtn && mobileMenu) {
          let isOpen = false;
          
          const toggleMenu = () => {
            isOpen = !isOpen;
            // Get all inner elements we want to animate
            const animatedElements = document.querySelectorAll('.mobile-link, .fade-in-element');

            if (isOpen) {
              mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
              mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
              document.body.style.overflow = 'hidden';
              
              // Animate internal items
              animatedElements.forEach((el, index) => {
                setTimeout(() => {
                  el.classList.remove('translate-y-4', 'opacity-0');
                  el.classList.add('translate-y-0', 'opacity-100');
                }, 50 * index);
              });

              if (mobileBtn.children.length === 3) {
                mobileBtn.children[0].classList.add('rotate-45', 'translate-x-[2px]', '-translate-y-[1px]');
                mobileBtn.children[1].classList.add('opacity-0');
                mobileBtn.children[2].classList.add('-rotate-45', 'translate-x-[2px]', 'translate-y-[1px]');
              }
            } else {
              mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
              mobileMenu.classList.add('opacity-0', 'pointer-events-none');
              document.body.style.overflow = '';

              // Reset internal items
              animatedElements.forEach((el) => {
                el.classList.add('translate-y-4', 'opacity-0');
                el.classList.remove('translate-y-0', 'opacity-100');
              });

              if (mobileBtn.children.length === 3) {
                mobileBtn.children[0].classList.remove('rotate-45', 'translate-x-[2px]', '-translate-y-[1px]');
                mobileBtn.children[1].classList.remove('opacity-0');
                mobileBtn.children[2].classList.remove('-rotate-45', 'translate-x-[2px]', 'translate-y-[1px]');
              }
            }
          };

          // Remove any old listeners (if the script runs multiple times) by replacing the element
          // Alternatively, since astro:page-load rebuilds the DOM for the newly loaded page, 
          // adding listeners is perfectly safe here.
          mobileBtn.addEventListener('click', toggleMenu);
          mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
        }
      });
    </script>

    <Analytics />
  </body>
</html>

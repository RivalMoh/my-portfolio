---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'rvlwhy@gmail.com';
const subject = encodeURIComponent('Project Collaboration Inquiry');
const body = encodeURIComponent('Hi Rival,\n\nI want to discuss a project regarding...\n');
const mailtoHref = `mailto:${email}?subject=${subject}&body=${body}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Rival Moh. Wahyudi',
  url: Astro.site ? new URL('/contact', Astro.site).toString() : 'https://rival-porto.vercel.app/contact',
};
---

<BaseLayout
  title="Contact | RivalMoh Portfolio"
  description="Get in touch for collaborations, freelance work, and engineering opportunities."
  canonicalPath="/contact"
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="max-w-4xl mx-auto px-8 md:px-16 py-12">
    <h1 class="text-4xl font-bold text-white mb-4">Contact</h1>
    <p class="text-slate-300 mb-8 leading-relaxed">
      Open to technical collaborations in data engineering, machine learning, analytics platforms, and product-focused software systems.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
      <a href={mailtoHref} class="rounded-xl border border-slate-700 p-5 bg-tech-surface hover:border-tech-accent/60 transition-colors">
        <p class="text-slate-500 text-sm mb-1">Primary</p>
        <p class="text-white font-semibold">Email</p>
        <p class="text-tech-accent text-sm">{email}</p>
      </a>

      <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noreferrer" class="rounded-xl border border-slate-700 p-5 bg-tech-surface hover:border-tech-accent/60 transition-colors">
        <p class="text-slate-500 text-sm mb-1">Professional Network</p>
        <p class="text-white font-semibold">LinkedIn</p>
        <p class="text-tech-accent text-sm">Message me directly</p>
      </a>
    </div>

    <div class="rounded-xl border border-slate-700 p-6 bg-tech-surface">
      <h2 class="text-xl text-white font-semibold mb-3">What to include in your message</h2>
      <ul class="list-disc pl-6 space-y-2 text-slate-300">
        <li>Project or role scope</li>
        <li>Expected timeline</li>
        <li>Tech stack and constraints</li>
      </ul>
    </div>
  </main>
</BaseLayout>
---
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'rvlwhy@gmail.com';
const subject = encodeURIComponent('Project Collaboration Inquiry');
const body = encodeURIComponent('Hi Rival,\n\nI want to discuss a project regarding...\n');
const mailtoHref = `mailto:${email}?subject=${subject}&body=${body}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Rival Moh. Wahyudi',
  url: Astro.site ? new URL('/contact', Astro.site).toString() : 'https://rival-porto.vercel.app/contact',
};
---

<BaseLayout
  title="Contact — Rival Moh. Wahyudi"
  description="Get in touch for collaborations, freelance work, and engineering opportunities."
  canonicalPath="/contact"
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="max-w-4xl mx-auto px-8 md:px-16 py-12">
    <h1 class="text-4xl font-display font-bold text-text-primary mb-4">Contact</h1>
    <p class="text-text-secondary mb-8 leading-relaxed max-w-[65ch]">
      Open to technical collaborations in data engineering, machine learning, analytics platforms, and product-focused software systems.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
      <!-- Email: filled/primary CTA -->
      <a
        href={mailtoHref}
        class="rounded-xl border-2 border-accent p-5 bg-accent/10 hover:bg-accent/20 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
      >
        <p class="text-text-tertiary text-sm mb-1">Primary</p>
        <p class="text-text-primary font-semibold">Email</p>
        <p class="text-accent text-sm">{email}</p>
      </a>

      <!-- LinkedIn: outlined/secondary CTA -->
      <a
        href="https://www.linkedin.com/in/rivalmohwahyudi"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn profile (opens in new tab)"
        class="rounded-xl border border-border-default p-5 bg-bg-surface hover:border-border-focus transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
      >
        <p class="text-text-tertiary text-sm mb-1">Professional Network</p>
        <p class="text-text-primary font-semibold">LinkedIn</p>
        <p class="text-text-secondary text-sm">Message me directly</p>
      </a>
    </div>

    <div class="rounded-xl border border-border-default p-6 bg-bg-surface">
      <h2 class="text-xl text-text-primary font-semibold mb-3">What to include in your message</h2>
      <ul class="list-disc pl-6 space-y-2 text-text-secondary">
        <li>Project or role scope</li>
        <li>Expected timeline</li>
        <li>Tech stack and constraints</li>
      </ul>
    </div>
  </main>
</BaseLayout>
---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, summary, date, stack, githubUrl, demoUrl, role, impact, duration, metrics, tags, coverImage } = entry.data;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description: summary,
  url: Astro.site ? new URL(`/projects/${entry.id}`, Astro.site).toString() : undefined,
  programmingLanguage: stack,
};
---

<ProjectLayout
  title={title}
  summary={summary}
  formattedDate={formattedDate}
  stack={stack}
  headings={headings}
  githubUrl={githubUrl}
  demoUrl={demoUrl}
  canonicalPath={`/projects/${entry.id}`}
  role={role}
  impact={impact}
  duration={duration}
  metrics={metrics}
  tags={tags}
  coverImage={coverImage}
  jsonLd={jsonLd}
>
  <Content />
</ProjectLayout>
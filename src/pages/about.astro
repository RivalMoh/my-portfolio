---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Rival Moh. Wahyudi',
  url: Astro.site ? new URL('/about', Astro.site).toString() : 'https://rival-porto.vercel.app/about',
};
---

<BaseLayout
  title="About | RivalMoh Portfolio"
  description="Background, skills, and work focus in data, ML, and software systems."
  canonicalPath="/about"
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="max-w-4xl mx-auto px-8 md:px-16 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12 items-start">
      
      {/* Text takes 8 columns on desktop */}
      <div class="md:col-span-8 order-last md:order-first">
        <h1 class="text-4xl font-bold text-white mb-6">About Me</h1>
        <p class="text-slate-300 leading-relaxed mb-8">
          I am a data and machine learning engineer focused on turning messy real-world problems into practical systems. My work emphasizes reliability, measurable outcomes, and clear technical documentation.
        </p>
      </div>

      {/* Image takes 4 columns on desktop */}
      <div class="md:col-span-4 order-first md:order-last">
        <div class="rounded-2xl overflow-hidden border border-slate-700 bg-slate-800 shadow-xl aspect-square max-w-sm mx-auto md:max-w-none">
          <img 
            src="/profile.jpg" 
            alt="Rival Moh. Wahyudi" 
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" 
          />
        </div>
      </div>
      
    </div>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold text-white mb-3">Core Strengths</h2>
      <ul class="space-y-2 text-slate-300 list-disc pl-6">
        <li>Data pipeline design and ETL architecture</li>
        <li>Applied machine learning for decision support systems</li>
        <li>Dashboarding and analytics for operations and product teams</li>
      </ul>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold text-white mb-3">Current Focus</h2>
      <p class="text-slate-300 leading-relaxed">
        Building systems that connect data ingestion, model inference, and stakeholder-facing analytics in one reproducible workflow.
      </p>
    </section>

    <section>
      <h2 class="text-2xl font-semibold text-white mb-3">Resume and Profiles</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/resume.pdf" class="px-4 py-2 rounded-lg bg-tech-accent/10 text-tech-accent border border-tech-accent/40 hover:bg-tech-accent/20 transition-colors">
          Download Resume
        </a>
        <a href="https://github.com/RivalMoh" target="_blank" rel="noreferrer" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 transition-colors">
          GitHub
        </a>
        <a href="https://www.linkedin.com/in/rivalmohwahyudi" target="_blank" rel="noreferrer" class="px-4 py-2 rounded-lg bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 transition-colors">
          LinkedIn
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
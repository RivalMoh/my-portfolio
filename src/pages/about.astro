---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import profileImage from "../assets/images/profile.jpg";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Rival Moh. Wahyudi",
  url: Astro.site
    ? new URL("/about", Astro.site).toString()
    : "https://rival-porto.vercel.app/about",
};
---

<BaseLayout
  title="About — Rival Moh. Wahyudi"
  description="Background, skills, and work focus in data, ML, and software systems."
  canonicalPath="/about"
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="max-w-4xl mx-auto px-8 md:px-16 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-16 items-start">
      {/* Text takes 8 columns on desktop */}
      <div class="md:col-span-8 order-last md:order-first">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-text-primary mb-6 tracking-tight">About Me</h1>
        <div class="prose prose-invert max-w-none prose-p:max-w-[65ch]">
          <p class="text-text-secondary text-lg leading-relaxed mb-6">
            I am a data and machine learning engineer focused on turning messy
            real-world problems into practical systems. My work emphasizes
            reliability, measurable outcomes, and clear technical documentation.
          </p>
          <p class="text-text-secondary text-lg leading-relaxed mb-8">
            Beyond simply training models, I specialize in the end-to-end lifecycle: 
            from designing robust data ingestion pipelines and ETL architecture, 
            to exposing AI inference through scalable APIs, and building interactive 
            dashboards that stakeholders can actually use.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="/resume.pdf"
            class="px-5 py-2.5 rounded-lg bg-accent text-bg-base font-medium hover:bg-accent-hover transition-colors shadow-[0_0_15px_rgba(79,158,248,0.3)] focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            Download Resume
          </a>
          <a
            href="https://github.com/RivalMoh"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile (opens in new tab)"
            class="px-5 py-2.5 rounded-lg bg-bg-elevated text-text-primary border border-border-default hover:border-border-focus transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/rivalmohwahyudi"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile (opens in new tab)"
            class="px-5 py-2.5 rounded-lg bg-bg-elevated text-text-primary border border-border-default hover:border-border-focus transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            LinkedIn
          </a>
        </div>
      </div>

      {/* Image takes 4 columns on desktop */}
      <div class="md:col-span-4 order-first md:order-last">
        <div
          class="rounded-2xl overflow-hidden border border-border-default bg-bg-surface shadow-xl aspect-square max-w-sm mx-auto md:max-w-none relative group"
        >
          <div class="absolute inset-0 bg-accent/20 mix-blend-overlay group-hover:opacity-0 transition-opacity duration-500 z-10"></div>
          <Image
            src={profileImage}
            alt="Rival Moh. Wahyudi — Data and ML Engineer"
            width={400}
            height={400}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover grayscale group-hover:grayscale-0 transition-all duration-500 relative z-0"
          />
        </div>
      </div>
    </div>

    <section class="mb-16">
      <h2 class="text-2xl font-bold text-text-primary mb-8 border-b border-border-default pb-4">Core Technology Stack</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-bg-surface border border-border-default rounded-xl p-6">
          <h3 class="text-accent font-mono text-sm uppercase tracking-wider mb-4">Data & ML</h3>
          <ul class="space-y-2 text-text-secondary">
            <li>Python, Pandas, NumPy</li>
            <li>Scikit-Learn, PyTorch</li>
            <li>PostgreSQL, SQLite</li>
            <li>Airflow, dbt</li>
          </ul>
        </div>
        <div class="bg-bg-surface border border-border-default rounded-xl p-6">
          <h3 class="text-accent font-mono text-sm uppercase tracking-wider mb-4">Engineering</h3>
          <ul class="space-y-2 text-text-secondary">
            <li>FastAPI, REST APIs</li>
            <li>Docker, CI/CD</li>
            <li>Git, GitHub Actions</li>
            <li>Cloud Providers (GCP/AWS)</li>
          </ul>
        </div>
        <div class="bg-bg-surface border border-border-default rounded-xl p-6">
          <h3 class="text-accent font-mono text-sm uppercase tracking-wider mb-4">Frontend & Viz</h3>
          <ul class="space-y-2 text-text-secondary">
            <li>Astro, React.js</li>
            <li>Tailwind CSS</li>
            <li>Tableau, Metabase</li>
            <li>Leaflet / Geospatial UI</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-bold text-text-primary mb-8 border-b border-border-default pb-4">Experience & Timeline</h2>
      <div class="space-y-8 border-l border-border-default ml-3 pl-8 relative">
        <div class="relative">
          <div class="absolute -left-[41px] top-1.5 w-4 h-4 rounded-full bg-bg-surface border-2 border-accent"></div>
          <p class="text-sm font-mono text-accent mb-1">Present</p>
          <h3 class="text-xl font-bold text-text-primary">Data & ML Engineer</h3>
          <p class="text-text-secondary mt-2 leading-relaxed max-w-[65ch]">
            Building systems that connect data ingestion, model inference, and stakeholder-facing analytics in one reproducible workflow. Exploring multimodal AI and automated data architectures.
          </p>
        </div>
        
        <div class="relative">
          <div class="absolute -left-[41px] top-1.5 w-4 h-4 rounded-full bg-bg-surface border-2 border-border-emphasis"></div>
          <p class="text-sm font-mono text-text-tertiary mb-1">Previous Experience</p>
          <h3 class="text-xl font-bold text-text-primary">Data Engineering & Analytics</h3>
          <p class="text-text-secondary mt-2 leading-relaxed max-w-[65ch]">
            Focused on supply-chain logistics and civic intelligence. Architected ETL pipelines, reduced reporting overhead by 60%, and developed zero-friction Progressive Web Apps for disaster reporting.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

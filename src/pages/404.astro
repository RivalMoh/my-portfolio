---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Page Not Found" description="The requested path does not exist." canonicalPath="/404" ogType="website">
  <main class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6">
    <h1 class="text-6xl md:text-8xl font-mono font-bold text-tech-accent mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">System Path Not Found</h2>
    <p class="text-slate-400 max-w-md mb-8">
      The documentation or system architecture you are looking for has been moved or does not exist.
    </p>
    <a href="/" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-white rounded-lg font-medium transition-colors border border-slate-700">
      Return to Dashboard
    </a>
  </main>
</BaseLayout>
---
// 1. Import Astro's content fetching tool and your UI component
import { getCollection } from 'astro:content';
import BentoCard from '../components/BentoCard.astro';
import '../styles/global.css';

// 2. Fetch all projects from the 'projects' folder
const allProjects = await getCollection('projects');

// 3. Sort them by date (newest first) so your latest work is always at the top
const sortedProjects = allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Note: If you have a lot of projects later, you can uncomment this to only show 'featured' ones
// const featuredProjects = sortedProjects.filter(project => project.data.featured);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Portfolio | Technical Documentation</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  
  <body class="min-h-screen bg-tech-bg text-slate-300 font-sans antialiased selection:bg-tech-accent selection:text-tech-bg p-8 md:p-16 lg:p-24">
    
    <main class="max-w-6xl mx-auto">
      
      <header class="mb-20 mt-10">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight">
          Architecting Data into <br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-tech-accent to-blue-500">Actionable Systems.</span>
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
          Specializing in robust data pipelines, machine learning models, and insightful analytics. 
          Below is a curated collection of my technical documentation and case studies.
        </p>
      </header>

      <section>
        <div class="flex items-center justify-between mb-8 border-b border-slate-800 pb-4">
          <h2 class="text-2xl font-bold text-white">Technical Projects</h2>
          <span class="text-sm font-mono text-slate-500">{sortedProjects.length} Systems Documented</span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedProjects.map((project) => (
            <BentoCard project={project} />
          ))}
        </div>
      </section>
      
    </main>

  </body>
</html>
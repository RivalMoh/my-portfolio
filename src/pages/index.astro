---
import { getCollection } from "astro:content";
import BentoCard from "../components/BentoCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { slugifyCategory } from "../utils/slugify";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredProjects = sortedProjects.filter(
  (project) => project.data.featured,
);



const categories = [
  "All",
  ...new Set(sortedProjects.map((p) => p.data.category)),
];
const showFilter = sortedProjects.length >= 4;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Rival Moh. Wahyudi",
    jobTitle: "Data and ML Engineer",
    url: Astro.site?.toString() ?? "https://rival-porto.vercel.app/",
    sameAs: [
      "https://github.com/RivalMoh",
      "https://www.linkedin.com/in/rivalmohwahyudi",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Rival Moh. Wahyudi | Data & ML Engineer",
    url: Astro.site?.toString() ?? "https://rival-porto.vercel.app/",
  },
];
---

<BaseLayout
  title="Portfolio | Data, ML, and Software Systems"
  description="Technical portfolio with case studies across machine learning, analytics, and software engineering."
  canonicalPath="/"
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="max-w-6xl mx-auto px-8 md:px-16 lg:px-24 py-10 md:py-16 relative">
    <section class="mb-20 relative">
      <!-- Animated background SVG -->
      <svg 
        aria-hidden="true" 
        focusable="false"
        class="absolute inset-0 w-full h-full opacity-20 pointer-events-none -z-10"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <pattern id="dot-grid" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="1" fill="currentColor" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#dot-grid)" />
      </svg>

      <p
        class="hero-overline text-xs font-mono uppercase tracking-widest text-accent mb-4"
      >
        Data &amp; ML Engineer
      </p>
      <h1
        class="hero-headline text-text-primary mb-6"
      >
        Architecting data into
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-blue-500"
        >
          actionable systems.</span
        >
      </h1>
      <p class="hero-body text-lg text-text-secondary max-w-[55ch] leading-relaxed mb-8">
        I build end-to-end solutions spanning data pipelines, machine learning,
        and analytics dashboards. Each project documents problem framing,
        implementation choices, and measurable outcomes.
      </p>

      <div class="hero-ctas flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-bg-base font-medium rounded-md hover:bg-accent-hover transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
        >
          View Projects
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 px-6 py-3 border border-border-default text-text-primary font-medium rounded-md hover:bg-bg-elevated transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
        >
          Contact
        </a>
      </div>
    </section>

    <section class="mb-20 reveal-on-scroll" id="about">
      <div
        class="border border-border-default bg-bg-surface rounded-2xl p-6 md:p-8"
      >
        <h2 class="text-2xl font-bold text-text-primary mb-4">About</h2>
        <p class="text-text-secondary leading-relaxed max-w-[65ch]">
          My focus is translating ambiguous business and civic problems into
          robust technical systems. I care about production reliability, clear
          documentation, and measurable impact, not only model accuracy.
        </p>
      </div>
    </section>

    <section class="mb-20 reveal-on-scroll" id="projects">
      <div
        class="flex items-center justify-between mb-8 border-b border-border-default pb-4"
      >
        <h2 class="text-2xl font-bold text-text-primary">Featured Projects</h2>
        <span class="text-sm font-mono text-text-secondary"
          >{featuredProjects.length} highlighted</span
        >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project) => <div class="reveal-on-scroll"><BentoCard project={project} /></div>)}
      </div>
    </section>

    <section class="mb-20 reveal-on-scroll">
      <div
        class="flex items-center justify-between mb-8 border-b border-border-default pb-4"
      >
        <h2 class="text-2xl font-bold text-text-primary">Filter Projects</h2>
        <span class="text-sm font-mono text-text-secondary"
          >{sortedProjects.length} documented</span
        >
      </div>

      {showFilter && (
        <div class="flex flex-wrap gap-2 mb-6 filter-group" role="group" aria-label="Filter projects by category">
          {
            categories.map((category) => {
              const filterValue = slugifyCategory(category);
              const active = category === "All";

              return (
                <button
                  data-filter={filterValue}
                  aria-pressed={active ? "true" : "false"}
                  class={`category-filter px-3 py-1.5 rounded-md text-sm border transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400 ${
                    active
                      ? "bg-bg-elevated text-text-primary border-border-focus"
                      : "bg-transparent text-text-secondary border-border-default hover:border-border-focus"
                  }`}
                >
                  {category}
                </button>
              );
            })
          }
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedProjects.map((project) => <div class="reveal-on-scroll"><BentoCard project={project} /></div>)}
      </div>
    </section>

    <section id="contact" class="reveal-on-scroll">
      <div
        class="border border-border-default bg-bg-surface rounded-2xl p-6 md:p-8"
      >
        <h2 class="text-2xl font-bold text-text-primary mb-4">Let’s Collaborate</h2>
        <p class="text-text-secondary mb-6 leading-relaxed max-w-[65ch]">
          Open to data, ML, and software engineering opportunities. If you have
          a project or role in mind, feel free to reach out.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="mailto:rvlwhy@gmail.com"
            class="px-4 py-2 rounded-lg bg-accent/10 text-accent border border-accent/40 hover:bg-accent/20 transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            Email Me
          </a>
          <a
            href="https://github.com/RivalMoh"
            target="_blank"
            rel="noreferrer"
            class="px-4 py-2 rounded-lg bg-bg-elevated text-text-primary border border-border-default hover:border-border-focus transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/rivalmohwahyudi"
            target="_blank"
            rel="noreferrer"
            class="px-4 py-2 rounded-lg bg-bg-elevated text-text-primary border border-border-default hover:border-border-focus transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('astro:page-load', () => {
      // Filter logic
      const buttons = document.querySelectorAll('.category-filter');
      const cards = document.querySelectorAll('.project-card');

      if (buttons.length > 0) {
        buttons.forEach((button) => {
          button.addEventListener('click', () => {
            // 1. Update active state on buttons
            buttons.forEach((b) => {
              b.classList.remove('bg-bg-elevated', 'text-text-primary', 'border-border-focus');
              b.classList.add('bg-transparent', 'text-text-secondary', 'border-border-default');
              b.setAttribute('aria-pressed', 'false');
            });
            button.classList.remove('bg-transparent', 'text-text-secondary', 'border-border-default');
            button.classList.add('bg-bg-elevated', 'text-text-primary', 'border-border-focus');
            button.setAttribute('aria-pressed', 'true');

            // 2. Filter cards
            const filter = button.getAttribute('data-filter');
            cards.forEach((card) => {
              const category = card.getAttribute('data-category');
              // Find the parent div with .reveal-on-scroll if any
              const cardContainer = card.parentElement?.classList.contains('reveal-on-scroll') ? card.parentElement : card;
              
              if (filter === 'all' || filter === category) {
                cardContainer.classList.remove('hidden');
                // The container needs display block or contents usually, or we just remove hidden.
                if(cardContainer !== card) {
                   card.classList.remove('hidden');
                   card.classList.add('flex');
                }
              } else {
                cardContainer.classList.add('hidden');
                if(cardContainer !== card) {
                   card.classList.add('hidden');
                   card.classList.remove('flex');
                }
              }
            });
          });
        });
      }

      // Intersection Observer for scroll animations
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal-on-scroll').forEach(el => observer.observe(el));
    });
  </script>
</BaseLayout>

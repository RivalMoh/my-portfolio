---
// This grabs the strict types we defined in config.ts
import type { CollectionEntry } from "astro:content";
import { slugifyCategory } from "../utils/slugify";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, category, stack } = project.data;

const routeId = project.id;
---

<a
  href={`/projects/${routeId}`}
  data-category={slugifyCategory(category)}
  aria-labelledby={`card-title-${routeId}`}
  class="project-card group relative flex flex-col p-6 rounded-2xl bg-bg-surface border border-border-default hover:border-border-focus transition-colors duration-300 overflow-hidden focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-blue-400"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
  >
  </div>

  <div class="relative z-10 flex-grow flex flex-col">
    <div class="flex items-center justify-between mb-4">
      <span class="text-xs font-mono text-text-secondary bg-bg-elevated border border-border-default px-2.5 py-1 rounded uppercase tracking-wider" aria-label={`Category: ${category}`}>
        {category}
      </span>
      <svg
        class="w-5 h-5 text-text-tertiary group-hover:text-accent transition-all duration-300 transform group-hover:translate-x-1 group-hover:-translate-y-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </div>

    <h3 id={`card-title-${routeId}`} class="text-xl font-bold text-text-primary mb-2 leading-tight">
      {title}
    </h3>

    <p class="text-sm text-text-secondary mb-6 line-clamp-2">
      {summary}
    </p>
  </div>

  <div class="relative z-10 flex flex-wrap gap-2 mt-auto mb-4" aria-label="Technologies used">
    {
      stack
        .slice(0, 3)
        .map((tech) => (
          <span class="px-2.5 py-1 text-xs font-mono rounded-md bg-bg-elevated text-text-secondary border border-border-default">
            {tech}
          </span>
        ))
    }
    {
      stack.length > 3 && (
        <span
          title={stack.slice(3).join(", ")}
          class="px-2.5 py-1 text-xs font-mono rounded-md bg-transparent text-text-tertiary cursor-help"
        >
          +{stack.length - 3}
        </span>
      )
    }
  </div>

  <div class="relative z-10 mt-auto pt-4 border-t border-border-default/50">
    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:gap-2.5 transition-all">
      Read Documentation <span aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>
